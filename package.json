{
  "name": "salvando-el-semestre",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/tokenVercel.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "db:migrar": "node --env-file=.env.local scripts/migrar.mjs",
    "db:verificar": "node --env-file=.env.local scripts/verificar-bd.mjs",
    "db:limpiar": "node --env-file=.env.local scripts/limpiar-prueba.mjs",
    "probar:flujo": "node --conditions=react-server --env-file=.env.local --import tsx scripts/probar-flujo.ts",
    "db:demo": "node --conditions=react-server --env-file=.env.local --import tsx scripts/cargar-demo.ts",
    "test": "vitest run",
    "test:ver": "vitest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/connect": "^2.5.2",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.2.0",
    "next": "16.3.5",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^64.5.0",
    "vitest": "^4.1.11"
  }
}
